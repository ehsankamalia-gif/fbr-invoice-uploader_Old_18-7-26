# Environment Selection: SANDBOX or PRODUCTION
FBR_ENV=SANDBOX

# FBR Sandbox Settings
FBR_SANDBOX_API_BASE_URL=https://esp.fbr.gov.pk:8243/PT/v1
FBR_SANDBOX_POS_ID=
FBR_SANDBOX_USIN=
FBR_SANDBOX_AUTH_TOKEN=
FBR_SANDBOX_TAX_RATE=18.0
FBR_SANDBOX_PCT_CODE=8711.2010
FBR_SANDBOX_INVOICE_TYPE=Standard
FBR_SANDBOX_DISCOUNT=0.0
FBR_SANDBOX_ITEM_CODE=
FBR_SANDBOX_ITEM_NAME=

# FBR Production Settings
FBR_PROD_API_BASE_URL=https://esp.fbr.gov.pk:8243/PT/v1
FBR_PROD_POS_ID=
FBR_PROD_USIN=
FBR_PROD_AUTH_TOKEN=
FBR_PROD_TAX_RATE=18.0
FBR_PROD_PCT_CODE=8711.2010
FBR_PROD_INVOICE_TYPE=Standard
FBR_PROD_DISCOUNT=0.0
FBR_PROD_ITEM_CODE=
FBR_PROD_ITEM_NAME=

# Database Settings (MySQL)
# On startup the application checks whether a MySQL server (Laragon/XAMPP) is
# actually reachable at DB_SERVER:DB_PORT.
#   - Reachable      -> MySQL is used, and the database plus all tables are
#                       created automatically if they do not exist yet.
#   - Not reachable  -> a local SQLite database in %APPDATA%\EhsanTraderFBR is
#                       used instead, so the app still runs on a machine with
#                       no database server installed.
# Once a machine has successfully used MySQL, it keeps using MySQL, so a
# stopped server reports a clear error instead of opening an empty database.
DB_SERVER=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=honda_fbr

# Application Settings
LOG_LEVEL=INFO
ENCRYPTION_KEY=
HONDA_PORTAL_USERNAME=
HONDA_PORTAL_PASSWORD=
