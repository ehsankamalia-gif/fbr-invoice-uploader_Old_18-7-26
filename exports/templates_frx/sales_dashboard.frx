<?xml version="1.0" encoding="utf-8"?>
<Report ScriptLanguage="CSharp" Dpi="100" DefaultFontFamily="Arial" DefaultFontSize="10" DefaultLcid="1033" ReportUnit="Centimeters" PageWidth="29.7" PageHeight="21" LeftMargin="1" RightMargin="1" TopMargin="1" BottomMargin="1" PrinterSettings="" Description="Sales Dashboard / Invoice Summary Export">
  <Dictionary>
    <JsonDataSource Name="Data" Alias="Data" ConnectionString="dataset.json" TableName="Data.Summary">
      <Column Name="from_date" DataType="System.String"/>
      <Column Name="to_date" DataType="System.String"/>
      <Column Name="status_filter" DataType="System.String"/>
      <Column Name="generated_at" DataType="System.String"/>
      <Column Name="business_name" DataType="System.String"/>
      <Column Name="total_invoices" DataType="System.Int32"/>
      <Column Name="total_amount" DataType="System.Decimal"/>
      <Column Name="avg_invoice_amount" DataType="System.Decimal"/>
      <Relation Name="DailySales" ParentDataSource="Data.Summary" ChildDataSource="Data.DailySales"/>
      <Relation Name="StatusBreakdown" ParentDataSource="Data.Summary" ChildDataSource="Data.StatusBreakdown"/>
      <Relation Name="Invoices" ParentDataSource="Data.Summary" ChildDataSource="Data.Invoices"/>
    </JsonDataSource>
    <TableDataSource Name="Data.DailySales" Alias="DailySales">
      <Column Name="date" DataType="System.String"/>
      <Column Name="amount" DataType="System.Decimal"/>
    </TableDataSource>
    <TableDataSource Name="Data.StatusBreakdown" Alias="StatusBreakdown">
      <Column Name="status" DataType="System.String"/>
      <Column Name="count" DataType="System.Int32"/>
    </TableDataSource>
    <TableDataSource Name="Data.Invoices" Alias="Invoices">
      <Column Name="invoice_number" DataType="System.String"/>
      <Column Name="datetime" DataType="System.String"/>
      <Column Name="pos_id" DataType="System.String"/>
      <Column Name="payment_mode" DataType="System.String"/>
      <Column Name="total_amount" DataType="System.Decimal"/>
      <Column Name="sync_status" DataType="System.String"/>
      <Column Name="fbr_invoice_number" DataType="System.String"/>
      <Column Name="usin" DataType="System.String"/>
    </TableDataSource>
  </Dictionary>
  <ReportPage Name="Page1" PaperSize="A4" Orientation="Landscape">
    <ReportTitleBand Name="title" Top="0" Width="27.7" Height="2.6" Fill="#0B1020">
      <TextObject Name="biz" Left="0.2" Top="0.3" Width="15" Height="0.9" Font="Arial, 18pt, style=Bold" TextColor="White" Text="[Data.Summary.business_name]"/>
      <TextObject Name="rep" Left="0.2" Top="1.2" Width="15" Height="0.6" Font="Arial, 13pt, style=Bold" TextColor="#CBD5E1" Text="SALES DASHBOARD REPORT"/>
      <TextObject Name="fromLbl" Left="17" Top="0.4" Width="2.2" Height="0.45" HorzAlign="Right" TextColor="#94A3B8" Text="From:"/>
      <TextObject Name="from" Left="19.3" Top="0.4" Width="8.2" Height="0.45" TextColor="White" Text="[Data.Summary.from_date]"/>
      <TextObject Name="toLbl" Left="17" Top="0.95" Width="2.2" Height="0.45" HorzAlign="Right" TextColor="#94A3B8" Text="To:"/>
      <TextObject Name="to" Left="19.3" Top="0.95" Width="8.2" Height="0.45" TextColor="White" Text="[Data.Summary.to_date]"/>
      <TextObject Name="statusLbl" Left="17" Top="1.5" Width="2.2" Height="0.45" HorzAlign="Right" TextColor="#94A3B8" Text="Status:"/>
      <TextObject Name="status" Left="19.3" Top="1.5" Width="8.2" Height="0.45" TextColor="White" Text="[Data.Summary.status_filter]"/>
      <TextObject Name="generated" Left="20" Top="2.05" Width="7.5" Height="0.45" HorzAlign="Right" TextColor="#94A3B8" Text="Generated [Data.Summary.generated_at]"/>
    </ReportTitleBand>
    <PageHeaderBand Name="kpis" Top="2.7" Width="27.7" Height="2.2">
      <ShapeObject Name="k1Box" Left="0.2" Top="0.2" Width="8.6" Height="1.8" SimpleBorderRadius="4" Fill="#EFF6FF" SimpleBorderColor="#2563EB" SimpleBorderWidth="1"/>
      <TextObject Name="k1Label" Left="0.5" Top="0.4" Width="8" Height="0.45" Text="Total Invoices" TextColor="#1D4ED8"/>
      <TextObject Name="k1Value" Left="0.5" Top="0.9" Width="8" Height="0.9" Font="Arial, 20pt, style=Bold" Text="[Data.Summary.total_invoices]"/>
      <ShapeObject Name="k2Box" Left="9.5" Top="0.2" Width="8.6" Height="1.8" SimpleBorderRadius="4" Fill="#ECFDF5" SimpleBorderColor="#059669" SimpleBorderWidth="1"/>
      <TextObject Name="k2Label" Left="9.8" Top="0.4" Width="8" Height="0.45" Text="Total Amount (Rs.)" TextColor="#047857"/>
      <TextObject Name="k2Value" Left="9.8" Top="0.9" Width="8" Height="0.9" Font="Arial, 18pt, style=Bold" Format="N2" Text="[Data.Summary.total_amount]"/>
      <ShapeObject Name="k3Box" Left="18.8" Top="0.2" Width="8.6" Height="1.8" SimpleBorderRadius="4" Fill="#FFF7ED" SimpleBorderColor="#EA580C" SimpleBorderWidth="1"/>
      <TextObject Name="k3Label" Left="19.1" Top="0.4" Width="8" Height="0.45" Text="Avg Invoice (Rs.)" TextColor="#C2410C"/>
      <TextObject Name="k3Value" Left="19.1" Top="0.9" Width="8" Height="0.9" Font="Arial, 18pt, style=Bold" Format="N2" Text="[Data.Summary.avg_invoice_amount]"/>
    </PageHeaderBand>
    <GroupHeaderBand Name="groupInvoices" Top="5" Width="27.7" Height="0.7">
      <TextObject Name="tblTitle" Left="0.2" Top="0.2" Width="10" Height="0.5" Font="Arial, 12pt, style=Bold" Text="Invoices (filtered)"/>
    </GroupHeaderBand>
    <ColumnHeaderBand Name="cols" Top="5.8" Width="27.7" Height="0.6" Fill="#0B1020">
      <TextObject Name="c1" Left="0.2" Top="0.1" Width="3.2" Height="0.45" Font="Arial, 9pt, style=Bold" TextColor="White" Text="Invoice #"/>
      <TextObject Name="c2" Left="3.4" Top="0.1" Width="4" Height="0.45" Font="Arial, 9pt, style=Bold" TextColor="White" Text="DateTime"/>
      <TextObject Name="c3" Left="7.4" Top="0.1" Width="2.2" Height="0.45" Font="Arial, 9pt, style=Bold" TextColor="White" Text="POS"/>
      <TextObject Name="c4" Left="9.6" Top="0.1" Width="3.2" Height="0.45" Font="Arial, 9pt, style=Bold" TextColor="White" Text="Payment"/>
      <TextObject Name="c5" Left="12.8" Top="0.1" Width="3.2" Height="0.45" Font="Arial, 9pt, style=Bold" TextColor="White" HorzAlign="Right" Text="Total"/>
      <TextObject Name="c6" Left="16" Top="0.1" Width="2.6" Height="0.45" Font="Arial, 9pt, style=Bold" TextColor="White" Text="Status"/>
      <TextObject Name="c7" Left="18.6" Top="0.1" Width="4.2" Height="0.45" Font="Arial, 9pt, style=Bold" TextColor="White" Text="FBR Invoice"/>
      <TextObject Name="c8" Left="22.8" Top="0.1" Width="4.8" Height="0.45" Font="Arial, 9pt, style=Bold" TextColor="White" Text="USIN"/>
    </ColumnHeaderBand>
    <DataBand Name="invRows" Top="6.5" Width="27.7" Height="0.55" DataSource="Data.Summary.Invoices">
      <TextObject Name="inv" Left="0.2" Top="0.1" Width="3.2" Height="0.45" Text="[invoice_number]"/>
      <TextObject Name="dt" Left="3.4" Top="0.1" Width="4" Height="0.45" Text="[datetime]"/>
      <TextObject Name="pos" Left="7.4" Top="0.1" Width="2.2" Height="0.45" Text="[pos_id]"/>
      <TextObject Name="mode" Left="9.6" Top="0.1" Width="3.2" Height="0.45" Text="[payment_mode]"/>
      <TextObject Name="tot" Left="12.8" Top="0.1" Width="3.2" Height="0.45" HorzAlign="Right" Format="N2" Text="[total_amount]"/>
      <TextObject Name="st" Left="16" Top="0.1" Width="2.6" Height="0.45" Text="[sync_status]"/>
      <TextObject Name="fbr" Left="18.6" Top="0.1" Width="4.2" Height="0.45" Text="[fbr_invoice_number]"/>
      <TextObject Name="usin" Left="22.8" Top="0.1" Width="4.8" Height="0.45" Text="[usin]"/>
    </DataBand>
    <PageFooterBand Name="footer" Top="18.8" Width="27.7" Height="1">
      <TextObject Name="note" Left="0.2" Top="0.3" Width="18" Height="0.5" TextColor="#777" Text="Dashboard export generated by Honda FBR Uploader."/>
      <TextObject Name="page" Left="21" Top="0.3" Width="6.5" Height="0.5" HorzAlign="Right" TextColor="#777" Text="Page [Page#] / [TotalPages#]"/>
    </PageFooterBand>
  </ReportPage>
</Report>
